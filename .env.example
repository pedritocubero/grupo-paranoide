# Copia este archivo a .env.local y rellena los valores reales.
# Nunca commitees .env.local (ya está en .gitignore).

# Connection string de Postgres (Neon, pooled connection).
DATABASE_URL=

# Secreto usado por Payload para firmar sesiones/tokens.
PAYLOAD_SECRET=

# API key de Anthropic, usada por el endpoint de traducción.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# URL base pública del sitio (usada en live preview y metadatos).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Credenciales de admin usadas SOLO por src/scripts/import-content.py.
# No hardcodear nunca en el propio script.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
